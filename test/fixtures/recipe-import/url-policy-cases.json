{
  "contractVersion": "web-recipe-import/v1",
  "networkAllowed": false,
  "cases": [
    {"id":"file-scheme","input":"file:///etc/passwd","expect":{"decision":"reject","stage":"validate_url","code":"SCHEME_UNSUPPORTED"}},
    {"id":"ftp-scheme","input":"ftp://public.example.test/recipe","expect":{"decision":"reject","stage":"validate_url","code":"SCHEME_UNSUPPORTED"}},
    {"id":"embedded-credentials","input":"https://user:secret@public.example.test/recipe","expect":{"decision":"reject","stage":"validate_url","code":"URL_CREDENTIALS_FORBIDDEN"}},
    {"id":"localhost","input":"http://localhost/recipe","expect":{"decision":"reject","stage":"validate_url","code":"HOST_FORBIDDEN"}},
    {"id":"localhost-subdomain","input":"http://x.localhost/recipe","expect":{"decision":"reject","stage":"validate_url","code":"HOST_FORBIDDEN"}},
    {"id":"single-label-host","input":"http://intranet/recipe","expect":{"decision":"reject","stage":"validate_url","code":"HOST_FORBIDDEN"}},
    {"id":"metadata-ip","input":"http://169.254.169.254/latest/meta-data","expect":{"decision":"reject","stage":"resolve","code":"ADDRESS_FORBIDDEN"}},
    {"id":"private-ipv4","input":"http://10.1.2.3/recipe","expect":{"decision":"reject","stage":"resolve","code":"ADDRESS_FORBIDDEN"}},
    {"id":"loopback-integer","input":"http://2130706433/recipe","expect":{"decision":"reject","stage":"resolve","code":"ADDRESS_FORBIDDEN","normalizedHost":"127.0.0.1"}},
    {"id":"loopback-hex","input":"http://0x7f000001/recipe","expect":{"decision":"reject","stage":"resolve","code":"ADDRESS_FORBIDDEN","normalizedHost":"127.0.0.1"}},
    {"id":"ipv6-loopback","input":"http://[::1]/recipe","expect":{"decision":"reject","stage":"resolve","code":"ADDRESS_FORBIDDEN"}},
    {"id":"ipv4-mapped-loopback","input":"http://[::ffff:127.0.0.1]/recipe","expect":{"decision":"reject","stage":"resolve","code":"ADDRESS_FORBIDDEN"}},
    {"id":"unique-local-ipv6","input":"http://[fd00::1]/recipe","expect":{"decision":"reject","stage":"resolve","code":"ADDRESS_FORBIDDEN"}},
    {"id":"link-local-ipv6","input":"http://[fe80::1]/recipe","expect":{"decision":"reject","stage":"resolve","code":"ADDRESS_FORBIDDEN"}},
    {"id":"documentation-ip","input":"https://192.0.2.10/recipe","expect":{"decision":"reject","stage":"resolve","code":"ADDRESS_FORBIDDEN"}},
    {"id":"non-default-port","input":"https://public.example.test:8443/recipe","expect":{"decision":"reject","stage":"validate_url","code":"PORT_FORBIDDEN"}},
    {
      "id":"mixed-dns-answer",
      "input":"https://mixed.example.test/recipe",
      "resolver":{"A":["93.184.216.34","10.0.0.8"],"AAAA":[]},
      "expect":{"decision":"reject","stage":"resolve","code":"DNS_MIXED_ADDRESS_SPACE"}
    },
    {
      "id":"redirect-to-private",
      "input":"https://public.example.test/recipe",
      "resolver":{"public.example.test":{"A":["93.184.216.34"],"AAAA":[]}},
      "transport":{"status":302,"location":"https://127.0.0.1/admin"},
      "expect":{"decision":"reject","stage":"redirect","code":"SSRF_BLOCKED_REDIRECT"}
    },
    {
      "id":"https-downgrade",
      "input":"https://public.example.test/recipe",
      "resolver":{"public.example.test":{"A":["93.184.216.34"],"AAAA":[]}},
      "transport":{"status":302,"location":"http://other-public.example.test/recipe"},
      "expect":{"decision":"reject","stage":"redirect","code":"INSECURE_REDIRECT"}
    },
    {
      "id":"public-approved-and-pinned",
      "input":"HTTPS://Public.Example.Test:443/a/../recipe?b=2&a=1#part",
      "resolver":{"A":["93.184.216.34"],"AAAA":["2606:2800:220:1:248:1893:25c8:1946"]},
      "expect":{"decision":"allow_fetch","normalizedUrl":"https://public.example.test/recipe?b=2&a=1","connectOnlyToResolverAnswers":true}
    }
  ]
}
