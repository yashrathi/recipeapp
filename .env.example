# Use at least 32 random characters outside local development.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Relative paths resolve from the project root.
DATABASE_PATH=.data/recipe-app.sqlite

# Optional server-only fallback for eligible public recipe pages that direct fetching cannot read.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2/scrape

# Optional server-only structured extraction for Firecrawl markdown and YouTube transcripts.
OPENAI_API_KEY=
OPENAI_RECIPE_MODEL=
OPENAI_API_URL=https://api.openai.com/v1/responses
