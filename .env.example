# Use at least 32 random characters outside local development.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Relative paths resolve from the project root.
DATABASE_PATH=.data/recipe-app.sqlite

# Optional server-only fallback for eligible public recipe pages that direct fetching cannot read.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2/scrape
# Set true only for a Firecrawl account with Zero Data Retention enabled.
FIRECRAWL_ZERO_DATA_RETENTION=false

# Set true only for a preview that deliberately offers the seeded homeowner
# and househelp demo sessions while the server runs in production mode.
PREVIEW_DEMO_AUTH=false

# Optional server-only structured extraction and automatic Hindi translation.
OPENAI_API_KEY=
OPENAI_RECIPE_MODEL=
# Optional; falls back to OPENAI_RECIPE_MODEL when left blank.
OPENAI_TRANSLATION_MODEL=
OPENAI_API_URL=https://api.openai.com/v1/responses
